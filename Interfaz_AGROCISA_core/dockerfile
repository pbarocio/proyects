# 1. Imagen base ligera con Python
FROM python:3.10-slim

# 2. Directorio de trabajo dentro del contenedor
WORKDIR /app

# 3. Copiar primero requirements (para aprovechar caché de Docker)
COPY requirements.txt .

# 4. Instalar dependencias (sin pip cache para reducir tamaño)
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copiar el resto del código
COPY . .

# 6. Exponer el puerto que usa Streamlit por defecto
EXPOSE 8501

# 7. Comando para arrancar la app
CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]